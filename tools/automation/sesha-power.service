[Unit]
Description=Shesha power profile auto-switch (AC/battery)
Documentation=https://github.com/gaganjainse/shesha-desktop
After=graphical-session.target

[Service]
Type=oneshot
# Triggered by udev rules via systemd-run; also usable manually:
#   systemctl --user start shesha-power.service
ExecStart=%h/.local/bin/shesha-power ac
RemainAfterExit=no
