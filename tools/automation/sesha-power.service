[Unit]
Description=Sesha power profile auto-switch (AC/battery)
Documentation=https://github.com/gaganjainse/Auto-desktopenv
After=graphical-session.target

[Service]
Type=oneshot
# Triggered by udev rules via systemd-run; also usable manually:
#   systemctl --user start sesha-power.service
ExecStart=%h/.local/bin/sesha-power ac
RemainAfterExit=no
