[Unit]
Description=Shesha ambient scheduler and proactivity
Documentation=https://github.com/gaganjainse/shesha-desktop
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/shesh-ambient tick
# Don't run if on low battery (the script also checks, but this is a hard guard)
ConditionPathExists=!/sys/class/power_supply/BAT0/status_low
TimeoutStartSec=120

[Install]
WantedBy=graphical-session.target
