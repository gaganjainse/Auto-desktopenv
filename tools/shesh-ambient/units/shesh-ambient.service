[Unit]
Description=Shesh ambient scheduler and proactivity
Documentation=https://github.com/gaganjainse/shesh-desktop
After=graphical-session.target
# Hard guard: don't fire on low battery (the script double-checks too)
ConditionPathExists=!/sys/class/power_supply/BAT0/status_low

[Service]
Type=oneshot
ExecStart=%h/.local/bin/shesh-ambient tick
TimeoutStartSec=120

[Install]
WantedBy=graphical-session.target
